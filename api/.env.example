# dev | prod  (/docs is only available in dev)
ENVIRONMENT=dev

# Local: Redis from the root docker-compose.yml
# Deployed: the Upstash Redis connection URL, stored as the REDIS_URL secret
# on the GitHub `dev` / `production` environment and pushed to Render on deploy.
# Copy the TLS URL from the Upstash console (note rediss://, with two s):
#   rediss://default:<password>@<database-name>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
