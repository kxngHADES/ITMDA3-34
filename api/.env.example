APP_NAME=SwiftQ

# dev | prod  (/docs is only available in dev)
ENVIRONMENT=dev

# Local: Redis from the root docker-compose.yml
# Deployed: the Upstash Redis connection URL, stored as the REDIS_URL secret
# on the GitHub `dev` / `production` environment and pushed to Render on deploy.
# Copy the TLS URL from the Upstash console (note rediss://, with two s):
#   rediss://default:<password>@<database-name>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Firebase console > Project settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Service account key downloaded from Project settings > Service accounts (keep out of git)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Generate with: openssl rand -base64 64 | tr -d '\n=' | tr '+/' '-_'
JWT_SECRET_KEY=replace-with-a-cryptographically-random-secret
JWT_ALGORITHM=HS256
# 10080 minutes = 7 days
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
