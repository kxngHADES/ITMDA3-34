APP_NAME=SwiftQ

# dev | prod  (/docs is only available in dev)
ENVIRONMENT=dev

# Local: Redis from the root docker-compose.yml
# Deployed: the Upstash Redis connection URL, stored as the REDIS_URL secret
# on the GitHub `dev` / `production` environment and pushed to Render on deploy.
# Copy the TLS URL from the Upstash console (note rediss://, with two s):
#   rediss://default:<password>@<database-name>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Firebase console > Project settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Service account key downloaded from Project settings > Service accounts (keep out of git)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Generate with: openssl rand -base64 64 | tr -d '\n=' | tr '+/' '-_'
JWT_SECRET_KEY=replace-with-a-cryptographically-random-secret
JWT_ALGORITHM=HS256
# 10080 minutes = 7 days
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed origins, comma-separated. * allows all (fine for now, lock down before launch)
CORS_ORIGINS=*


# email to SMS
CARRIER_GATEWAY=winsms.net
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=******


# Resend
RESEND_API_KEY=*******
RESEND_FROM_EMAIL=noreply@swiftq.ndaedzo.com
RESEND_FROM_NAME=SwiftQ

# Fernet key for stored phone numbers and emails. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When empty a key is derived from JWT_SECRET_KEY, so rotating that secret makes stored contacts unreadable.
PHONE_ENCRYPTION_KEY=

# A waiting patient gets the almost your turn alert once their position is this or lower
ALMOST_TURN_POSITION=3

# Redis token-bucket rate limits (join, call next). Set false to switch them off.
RATE_LIMIT_ENABLED=true
# Proxies in front of the API (Render = 1), so the client IP is read from X-Forwarded-For correctly
TRUSTED_PROXY_HOPS=1
