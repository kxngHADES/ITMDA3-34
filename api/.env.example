# dev | prod  (/docs is only available in dev)
ENVIRONMENT=dev

# Local: Redis from the root docker-compose.yml
# Deployed: the Render Key Value connection URL
#   internal (same Render region): redis://red-xxxxxxxxxxxx:6379
#   external: rediss://red-xxxxxxxxxxxx:<password>@<region>-keyvalue.render.com:6379
REDIS_URL=redis://localhost:6379/0
