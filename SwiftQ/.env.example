# SwiftQ patient app — build configuration.
#
# Copy this file to `.env` (same folder) and fill in your values. `.env` is git-ignored.
# Gradle reads it at build time and exposes each value in Kotlin as BuildConfig.<KEY>,
# e.g. BuildConfig.API_BASE_URL. Re-sync / rebuild after changing it.
#
# CI does not use this file: the workflow sets the same keys as environment variables
# from the GitHub `dev` or `prod` environment. An environment variable wins over `.env`.
#
# These values are compiled into the APK, so do not put server-side secrets here.

# Which backend this build talks to: local | dev | prod
APP_ENV=local

# Base URL of the SwiftQ API, no trailing slash.
#   local  http://10.0.2.2:8000                    (emulator -> uvicorn on your machine;
#                                                   on a real phone use your computer's LAN IP)
#   dev    https://swiftq-api-dev.onrender.com
#   prod   https://swiftq-api-prod.onrender.com
API_BASE_URL=http://10.0.2.2:8000
