# SwiftQ patient app — build configuration.
#
# Copy this file to `.env` (same folder) and fill in your values. `.env` is git-ignored.
# Gradle reads it at build time and exposes each value in Kotlin as BuildConfig.<KEY>,
# e.g. BuildConfig.API_BASE_URL. Re-sync / rebuild after changing it.
#
# CI does not use this file: the workflow sets the same keys as environment variables
# from the GitHub `dev` or `prod` environment. An environment variable wins over `.env`.
#
# These values are compiled into the APK, so do not put server-side secrets here.

# Which backend this build talks to: local | dev | prod
APP_ENV=local

# Base URL of the SwiftQ API, no trailing slash.
#   local  http://10.0.2.2:8000                    (emulator -> uvicorn on your machine;
#                                                   on a real phone use your computer's LAN IP)
#   dev    https://swiftq-api-dev.onrender.com
#   prod   https://swiftq-api-prod.onrender.com
API_BASE_URL=http://10.0.2.2:8000

# Firebase Web API Key (Firebase console > Project settings > General > "Web API Key").
# The app uses it to sign patients in anonymously, and to start Firebase for push.
FIREBASE_WEB_API_KEY=

# FCM push notifications.
# Download google-services.json (Firebase console > Project settings > Your apps > Android app, package
# com.itmda.swiftq) and put it in the root of the mobile app, next to this file (SwiftQ/google-services.json,
# not app/). It is git-ignored. The build does not read that file itself, so copy these from it:
#   FIREBASE_SENDER_ID   <- project_info.project_number
#   FIREBASE_PROJECT_ID  <- project_info.project_id
#   FIREBASE_APP_ID      <- client[0].client_info.mobilesdk_app_id   (looks like 1:123456789:android:abc123)
# Leave blank to build without push; the app then relies on SMS/email fallbacks from the API.
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
