<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary action button -->
    <style name="Widget.SwiftQ.Button.Primary"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/action_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.SwiftQ.Button</item>

    </style>

    <!-- Secondary action button -->
    <style name="Widget.SwiftQ.Button.Secondary"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/swiftq_blue_50</item>
        <item name="android:textColor">@color/text_link</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.SwiftQ.Button</item>

    </style>

    <!-- Destructive action button -->
    <style name="Widget.SwiftQ.Button.Danger"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/swiftq_error_tint</item>
        <item name="android:textColor">@color/swiftq_error_text</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.SwiftQ.Button</item>

    </style>

</resources>