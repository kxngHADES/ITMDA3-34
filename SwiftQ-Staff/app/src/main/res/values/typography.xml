<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Large page titles -->
    <style name="TextAppearance.SwiftQ.LargeTitle"
        parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Section titles -->
    <style name="TextAppearance.SwiftQ.Title"
        parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_title_1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card headings -->
    <style name="TextAppearance.SwiftQ.Headline"
        parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Standard body text -->
    <style name="TextAppearance.SwiftQ.Body"
        parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Supporting text -->
    <style name="TextAppearance.SwiftQ.Secondary"
        parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_subheading</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Button labels -->
    <style name="TextAppearance.SwiftQ.Button"
        parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_callout</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>