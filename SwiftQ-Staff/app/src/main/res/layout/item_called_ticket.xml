<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:orientation="vertical"
    android:padding="@dimen/space_3"
    android:background="@drawable/bg_nav_selected"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/calledTicketNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/swiftq_blue_pressed"
            android:textSize="@dimen/ticket_number_text"
            android:textStyle="bold"
            tools:text="A014"/>

        <TextView
            android:id="@+id/calledPatientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Sipho"/>

        <TextView
            android:id="@+id/calledPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_1"
            android:textSize="@dimen/text_footnote"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="Regular"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calledNoShowButton"
            style="@style/Widget.SwiftQ.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_2"
            android:minHeight="@dimen/touch_min"
            android:text="@string/action_no_show"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calledServedButton"
            style="@style/Widget.SwiftQ.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/action_served"/>

    </LinearLayout>

</LinearLayout>
