<?xml version="1.0" encoding="utf-8"?>
<!-- The root is header-blue so the status bar strip matches the header
     while the content scrolls underneath it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_header">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/dashboard_background">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.swiftq.staff.ui.MaxWidthLinearLayout
                    android:id="@+id/dashboardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:descendantFocusability="beforeDescendants"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    app:maxWidth="@dimen/content_max_width">

                    <!-- SWIFTQ HEADER -->
                    <LinearLayout
                        android:id="@+id/dashboardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dashboard_header_padding"
                        android:background="@drawable/bg_dashboard_header">

                        <!-- BRANDING ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_brand"
                                android:textColor="@color/dashboard_header_text"
                                android:textStyle="bold"
                                android:textSize="@dimen/text_title_3" />

                            <TextView
                                android:id="@+id/liveIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_staff_portal"
                                android:textColor="@color/dashboard_header_text"
                                android:textSize="@dimen/text_caption"
                                android:letterSpacing="0.08" />

                        </LinearLayout>

                        <!-- GREETING -->
                        <TextView
                            android:id="@+id/greetingText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/dashboard_greeting"
                            android:textAppearance="@style/TextAppearance.SwiftQ.LargeTitle"
                            android:textColor="@color/dashboard_header_text" />

                        <!-- TAGLINE -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/dashboard_tagline"
                            android:textColor="@color/dashboard_header_muted" />

                        <!-- QUEUE STATUS AND CONTROLS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_5"
                            android:orientation="vertical"
                            android:padding="@dimen/dashboard_card_padding"
                            android:background="@drawable/bg_dashboard_card">

                            <!-- CONNECTION STATUS -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dashboard_queue_status"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/queueSyncStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:gravity="end"
                                    android:text="@string/dashboard_awaiting_sync"
                                    android:textColor="@color/text_primary"
                                    android:accessibilityLiveRegion="polite" />

                            </LinearLayout>

                            <!-- SERVICE POINT SELECTOR -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/servicePointButton"
                                style="@style/Widget.SwiftQ.Button.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:minHeight="@dimen/touch_min"
                                android:text="@string/dashboard_select_service_point"
                                android:ellipsize="end"
                                android:maxLines="1" />

                            <!-- REFRESH AND LAST UPDATED -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/lastUpdatedValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dashboard_not_synced"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_caption" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/refreshQueueButton"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="@dimen/touch_min"
                                    android:text="@string/dashboard_refresh_short"
                                    android:textAllCaps="false"
                                    android:contentDescription="@string/dashboard_refresh" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- DASHBOARD CONTENT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/screen_horizontal_padding"
                        android:paddingTop="@dimen/space_5"
                        android:paddingBottom="@dimen/space_8">

                        <!-- OFFLINE BANNER -->
                        <TextView
                            android:id="@+id/offlineBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_4"
                            android:padding="@dimen/space_3"
                            android:background="@drawable/bg_offline_banner"
                            android:textColor="@color/swiftq_warning_text"
                            android:textSize="@dimen/text_footnote"
                            android:accessibilityLiveRegion="polite"
                            android:visibility="gone" />

                        <!-- ===================== OVERVIEW ===================== -->
                        <LinearLayout
                            android:id="@+id/overviewSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- STATISTIC CARDS -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <LinearLayout
                                    android:id="@+id/waitingStat"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="@dimen/space_2"
                                    android:orientation="vertical"
                                    android:padding="@dimen/dashboard_card_padding"
                                    android:background="@drawable/bg_dashboard_card">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_waiting"
                                        android:textAppearance="@style/TextAppearance.SwiftQ.Secondary"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <TextView
                                        android:id="@+id/waitingValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/dashboard_count_unavailable"
                                        android:textColor="@color/action_primary"
                                        android:textSize="@dimen/dashboard_stat_value"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/priorityStat"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="@dimen/space_2"
                                    android:orientation="vertical"
                                    android:padding="@dimen/dashboard_card_padding"
                                    android:background="@drawable/bg_dashboard_card">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_priority"
                                        android:textAppearance="@style/TextAppearance.SwiftQ.Secondary"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <TextView
                                        android:id="@+id/priorityValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/dashboard_count_unavailable"
                                        android:textColor="@color/dashboard_priority"
                                        android:textSize="@dimen/dashboard_stat_value"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/requestsStat"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="@dimen/dashboard_card_padding"
                                    android:background="@drawable/bg_dashboard_card">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_requests"
                                        android:textAppearance="@style/TextAppearance.SwiftQ.Secondary"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <TextView
                                        android:id="@+id/requestsValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_2"
                                        android:text="@string/dashboard_count_unavailable"
                                        android:textColor="@color/swiftq_progress"
                                        android:textSize="@dimen/dashboard_stat_value"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- NOW SERVING + CALL NEXT -->
                            <LinearLayout
                                android:id="@+id/nowServingCard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:orientation="vertical"
                                android:padding="@dimen/dashboard_card_padding"
                                android:background="@drawable/bg_dashboard_card">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/dashboard_now_serving"
                                        android:textAppearance="@style/TextAppearance.SwiftQ.Headline" />

                                    <TextView
                                        android:id="@+id/nowServingValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_count_unavailable"
                                        android:textColor="@color/action_primary"
                                        android:textSize="@dimen/ticket_number_text"
                                        android:textStyle="bold"
                                        android:accessibilityLiveRegion="polite" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/nowServingHint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/dashboard_now_serving_hint"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_footnote" />

                                <!-- Patients currently called to a counter -->
                                <LinearLayout
                                    android:id="@+id/calledContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:orientation="vertical" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/callNextButton"
                                    style="@style/Widget.SwiftQ.Button.Primary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:text="@string/action_call_next" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/addWalkInButton"
                                    style="@style/Widget.SwiftQ.Button.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:text="@string/action_add_walk_in" />

                            </LinearLayout>

                            <!-- PRIORITY REQUESTS -->
                            <LinearLayout
                                android:id="@+id/priorityRequestsSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_6"
                                    android:text="@string/dashboard_priority_requests"
                                    android:textAppearance="@style/TextAppearance.SwiftQ.Headline" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/dashboard_priority_requests_description"
                                    android:textColor="@color/text_secondary" />

                                <LinearLayout
                                    android:id="@+id/priorityRequestsContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:orientation="vertical" />

                            </LinearLayout>

                            <!-- UP NEXT -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_6"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dashboard_up_next"
                                    android:textAppearance="@style/TextAppearance.SwiftQ.Headline" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/viewFullQueueButton"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="@dimen/touch_min"
                                    android:text="@string/dashboard_view_full_queue"
                                    android:textAllCaps="false" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/upNextContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/upNextEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:padding="@dimen/space_6"
                                android:gravity="center"
                                android:background="@drawable/bg_dashboard_card"
                                android:text="@string/queue_empty"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <!-- ===================== FULL QUEUE ===================== -->
                        <LinearLayout
                            android:id="@+id/queueSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_patient_queue"
                                android:textAppearance="@style/TextAppearance.SwiftQ.Headline" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="@string/dashboard_queue_description"
                                android:textColor="@color/text_secondary" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:scrollbars="none">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/queueFilterGroup"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:singleLine="true"
                                    app:singleSelection="true"
                                    app:selectionRequired="true">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/filterAll"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        android:text="@string/filter_all" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/filterWaiting"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/filter_waiting" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/filterCalled"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/filter_called" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/filterPriority"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/filter_priority" />

                                </com.google.android.material.chip.ChipGroup>

                            </HorizontalScrollView>

                            <!-- PATIENT QUEUE CONTAINER -->
                            <LinearLayout
                                android:id="@+id/queueContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:orientation="vertical" />

                            <!-- EMPTY QUEUE STATE -->
                            <LinearLayout
                                android:id="@+id/emptyQueueState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/space_8"
                                android:background="@drawable/bg_dashboard_card">

                                <TextView
                                    android:id="@+id/emptyQueueTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dashboard_empty_title"
                                    android:textAppearance="@style/TextAppearance.SwiftQ.Headline"
                                    android:gravity="center" />

                                <TextView
                                    android:id="@+id/emptyQueueDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:text="@string/dashboard_empty_description"
                                    android:textColor="@color/text_secondary"
                                    android:gravity="center" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.swiftq.staff.ui.MaxWidthLinearLayout>

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- SWIFTQ BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dashboard_bottom_nav_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="@dimen/space_2"
        android:background="@color/nav_background"
        android:elevation="8dp"
        android:baselineAligned="false">

        <include
            android:id="@+id/navOverview"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/navQueue"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/navWalkin"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/navSettings"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
