<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.swiftq.staff.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_6"
            app:maxWidth="@dimen/detail_max_width">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_in_title"
                android:textAppearance="@style/TextAppearance.SwiftQ.Title" />

            <TextView
                android:id="@+id/walkInSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.SwiftQ.Secondary" />

            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/walkInNameLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:hint="@string/walk_in_name"
                app:helperText="@string/walk_in_name_helper"
                app:counterEnabled="true"
                app:counterMaxLength="40">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/walkInNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Language -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/walk_in_language">

                <AutoCompleteTextView
                    android:id="@+id/walkInLanguageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:inputType="none"
                    android:paddingHorizontal="@dimen/space_4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Priority category -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/walk_in_priority"
                app:helperText="@string/walk_in_priority_helper">

                <AutoCompleteTextView
                    android:id="@+id/walkInPriorityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:inputType="none"
                    android:paddingHorizontal="@dimen/space_4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Notification channel -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/walk_in_channel">

                <AutoCompleteTextView
                    android:id="@+id/walkInChannelInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:inputType="none"
                    android:paddingHorizontal="@dimen/space_4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone (only for SMS alerts) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/walkInPhoneLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/walk_in_phone"
                android:visibility="gone"
                app:helperText="@string/walk_in_phone_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/walkInPhoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:autofillHints="phone"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email (only for email alerts) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/walkInEmailLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/walk_in_email"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/walkInEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/walkInError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:padding="@dimen/space_3"
                android:background="@drawable/bg_offline_banner"
                android:textColor="@color/swiftq_error_text"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/walkInProgress"
                android:layout_width="@dimen/space_8"
                android:layout_height="@dimen/space_8"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3"
                android:indeterminateTint="@color/action_primary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walkInCancelButton"
                    style="@style/Widget.SwiftQ.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_2"
                    android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walkInSubmitButton"
                    style="@style/Widget.SwiftQ.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/walk_in_submit" />

            </LinearLayout>

        </com.swiftq.staff.ui.MaxWidthLinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>
